#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

rm -rf "$PROJECT_ROOT/dist" "$PROJECT_ROOT/.astro" "$PROJECT_ROOT/node_modules"
echo "✓ Removed repository build artifacts and dependencies"
echo "Run 'pnpm install' in $PROJECT_ROOT to reinstall dependencies"
