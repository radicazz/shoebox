#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./_nvm-load.sh
source "$SCRIPT_DIR/_nvm-load.sh"
# shellcheck source=./_pkgm.sh
source "$SCRIPT_DIR/_pkgm.sh"

echo "🏥 Checking $PROJECT_ROOT"
echo "✓ Node.js $(node --version); $PKGM_PRETTY_NAME"
EXIT_CODE=0

while IFS= read -r pkg; do
  if [ -d "node_modules/$pkg" ]; then
    echo "✓ $pkg installed"
  else
    echo "✗ $pkg missing; run 'pnpm install'" >&2
    EXIT_CODE=1
  fi
done < <(node --input-type=module -e '
  import { readFileSync } from "node:fs";
  const manifest = JSON.parse(readFileSync("package.json", "utf8"));
  console.log(Object.keys({ ...manifest.dependencies, ...manifest.devDependencies }).join("\n"));
')

for path in src/components src/layouts src/pages src/styles src/assets/gallery public/media; do
  if [ ! -d "$path" ]; then
    echo "✗ $path/ missing" >&2
    EXIT_CODE=1
  fi
done

for path in astro.config.mjs tailwind.config.mjs postcss.config.cjs pnpm-lock.yaml src/data/gallery.json; do
  if [ ! -f "$path" ]; then
    echo "✗ $path missing" >&2
    EXIT_CODE=1
  fi
done

if [ "$EXIT_CODE" -ne 0 ]; then
  exit "$EXIT_CODE"
fi

BUILD_LOG="$(mktemp "${TMPDIR:-/tmp}/shoebox-build.XXXXXX")"
if shoebox_pkgm_run validate:data > "$BUILD_LOG" 2>&1 &&
   shoebox_pkgm_run build >> "$BUILD_LOG" 2>&1 &&
   shoebox_pkgm_run check:output >> "$BUILD_LOG" 2>&1; then
  rm -f "$BUILD_LOG"
  echo "✓ Content, build, and output checks passed"
else
  echo "✗ Validation failed; see $BUILD_LOG" >&2
  exit 1
fi
