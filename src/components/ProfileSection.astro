---
export interface ProfileHeroData {
  name: string;
  photo: string;
  title?: string;
  location?: string;
  repository?: string;
}

export interface AboutCardData {
  text?: string;
  skills?: string[];
}

export interface Props {
  profileHero: ProfileHeroData;
  aboutCard?: AboutCardData;
}

const { profileHero, aboutCard } = Astro.props as Props;
const isExternal = /^(?:[a-z]+:)?\/\//i;
const normalizedBase = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const normalizedPhoto = profileHero.photo.replace(/^\//, '');
const defaultPhotoPath = `${normalizedBase ? normalizedBase : ''}/media/profile.svg`;
const fallbackPhoto = normalizedPhoto === 'media/profile.svg' ? null : defaultPhotoPath;
const resolvedPhoto = isExternal.test(profileHero.photo)
  ? profileHero.photo
  : `${normalizedBase ? normalizedBase : ''}/${normalizedPhoto}`;
const skillList = (aboutCard?.skills ?? []).filter(Boolean);
const initialTitle = (profileHero.title ?? '').trim() || '';
const initialLocation = (profileHero.location ?? '').trim() || '';
const hasInitialDivider = Boolean(initialTitle && initialLocation);

const repositoryLabel = (() => {
  try { return new URL(profileHero.repository ?? 'https://github.com/radicazz/shoebox').pathname.slice(1); }
  catch { return 'GitHub repository'; }
})();
---
<section class="profile-intro" aria-labelledby="profile-heading">
  <div class="profile-copy">
    <p class="section-kicker"><span aria-hidden="true">//</span> A little about me</p>
    <h1 id="profile-heading">Hey, I'm <span class="profile-name">{profileHero.name}</span><span class="theme-accent" aria-hidden="true">.</span></h1>
    {(initialTitle || initialLocation) && <p class="profile-meta theme-text-muted">{initialTitle}{hasInitialDivider && ' · '}{initialLocation}</p>}
    {aboutCard?.text && <p class="profile-about">{aboutCard.text}</p>}
    <a href={profileHero.repository ?? 'https://github.com/radicazz/shoebox'} target="_blank" rel="noopener noreferrer" class="profile-link">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m8 8-4 4 4 4m8-8 4 4-4 4m-3-12-2 16" /></svg>
      {repositoryLabel}<span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>
    </a>
    {skillList.length > 0 && <ul class="profile-skills" aria-label="Skills">{skillList.map((skill) => <li class="theme-chip">{skill}</li>)}</ul>}
  </div>
  <div class="profile-portrait">
    <div class="portrait-frame">
      <img src={resolvedPhoto} data-profile-photo data-fallback-src={fallbackPhoto ?? undefined} alt={`Photo of ${profileHero.name}`} width="180" height="180" loading="eager" class="profile-photo" />
    </div>
    <span class="portrait-caption" aria-hidden="true">~/hello-world</span>
  </div>
</section>

<script is:inline>
  (() => {
    const photo = document.querySelector('[data-profile-photo]');
    if (!(photo instanceof HTMLImageElement)) return;
    const fallback = photo.dataset.fallbackSrc;
    if (!fallback) return;
    const applyFallback = () => {
      if (photo.dataset.fallbackApplied) return;
      photo.dataset.fallbackApplied = 'true';
      photo.src = fallback;
    };
    photo.addEventListener('error', applyFallback);
    if (photo.complete && !photo.naturalWidth) applyFallback();
  })();
</script>

<style>
  .profile-intro { display: flex; flex-direction: column-reverse; gap: 2rem; padding-block: clamp(2.5rem, 6vw, 5rem); }
  .profile-copy { min-width: 0; }
  h1 { margin: 0.75rem 0 1.25rem; font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 700; line-height: 1.1; letter-spacing: -0.045em; color: var(--color-heading); }
  .profile-name { font-family: var(--font-mono); letter-spacing: -0.06em; }
  .profile-meta { margin-bottom: 1rem; }
  .profile-about { max-width: 55ch; font-size: 1.125rem; line-height: 1.75; color: var(--color-text-muted); }
  .profile-link { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 0.625rem; min-height: 44px; margin-top: 1.5rem; padding: 0.625rem 0.875rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface); font-family: var(--font-mono); font-size: 0.875rem; color: var(--color-accent); transition: border-color 180ms ease; }
  .profile-link:hover { border-color: var(--color-accent); }
  .profile-skills { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
  .profile-skills li { padding: 0.375rem 0.625rem; font-size: 0.75rem; color: var(--color-text-muted); }
  .profile-portrait { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }
  .portrait-frame { padding: 0.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
  .profile-photo { width: 120px; height: 120px; object-fit: cover; border-radius: var(--radius-sm); }
  .portrait-caption { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-text-muted); }
  @media (min-width: 640px) { .profile-intro { flex-direction: row; align-items: center; justify-content: space-between; gap: 2.5rem; } .profile-copy { flex: 1; } .profile-portrait { flex: 0 0 auto; align-items: center; } .profile-photo { width: 180px; height: 180px; } }
  @media (prefers-reduced-motion: reduce) { .profile-link { transition: none; } }
</style>
